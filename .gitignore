# Local research: private reference material (the project brief, ITRS
# documents and QGIS assets, real ITRS exports) and output from real runs.
# Only research/README.md is committed.
research/*
!research/README.md

# Belt and braces: real exports, tool output, and private reference files
# never get committed, wherever they land.
*.geojson
*.osm
*.report.md
*.report.html
*.pdf
*.zip
project_startup.txt
itrs_osm_schema.csv
in/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Tool output and cache (default locations)
cache/
out/
